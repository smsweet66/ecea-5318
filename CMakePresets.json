{
    "version": 5,
    "configurePresets": [
        {
            "name": "clang",
            "binaryDir": "build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_STANDARD": "11",
                "CMAKE_CXX_FLAGS": "-Wall -Wpedantic",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "clang",
            "configurePreset": "clang"
        }
    ]
}
